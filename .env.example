# Copy this file to .env.local (git ignores it) and set the backend the app talks to.
#
# Backend running on your own PC: use the PC's Wi-Fi IPv4 address (ipconfig), not "localhost". The app
# runs on the phone, where "localhost" is the phone itself. The phone must be on the same network, and
# the address changes when the PC joins another network.
#   EXPO_PUBLIC_API_URL=http://192.168.x.x:4000
#
# Shared backend (UAT / production): its public URL.
#   EXPO_PUBLIC_API_URL=https://<backend host>
#
# Leave it unset to run the app on its in-app demo data.
EXPO_PUBLIC_API_URL=http://192.168.x.x:4000
